{
    cfg_name: "hemaia_twochiplet_16MBL3_4cluster",
    bender_target: ["cv64a6_imafdc_sv39", "occamy"],
    // Two chiplets: one compute chip (4 clusters, 16 MiB L3) and, east of it, the
    // memory chip with its HBM.
    hemaia_multichip: {
      chip_id_width: 8,             // Not verified, should never be changed
      router_to_soc_iw: 4,          // soc_to_router_iw + clog2(chips)
      soc_to_router_iw: 4,          // Not beneficial for iw > 6
      single_chip: false,
      // Run the memory chip at the host clock, as the tapeout cfgs do. Without this it runs
      // at 1/20 of the main clock and the SW takes the slow-FPGA D2D path.
      same_memchip_speed: true,
      // The clocks the dsv2 layer was measured at: a 3.5 GHz master, the compute chips' host
      // and clusters and the memory chip's logic at /7 = 500 MHz, every D2D PHY at 3.5 GHz.
      sim_clock: {
        master_mhz: 3500,
        core_clk_div: 7,
        memchip_clk_div: 7
      },
      testbench_cfg: {
        hemaia_compute_chip: [
          {coordinate: [0,0]}
        ],
        hemaia_mem_chip: [
          {
            coordinate: [1,0],
            mem_size: 67108864,         // 64 MiB SRAM at chip-local 0x8000_0000
            // Simulated HBM (hw/hemaia/hemaia_mem_system/hbm); fields and defaults in
            // docs/schema/hemaia_hbm.schema.json. HBM2e as an AMD FPGA exposes it.
            hbm: {
              base: 4294967296,           // 0x1_0000_0000, chip-local
              size: 17179869184,          // 16 GiB
              num_channels: 32,           // pseudo-channels (2 stacks x 16)
              num_banks: 16,              // per pseudo-channel
              row_bytes: 1024,
              interleave_bytes: 4096,     // 0: one contiguous range per channel
              channel_mbps: 25600,        // 64 bit x 3.2 Gb/s per pseudo-channel
              t_ctrl_ps: 90000,           // controller + PHY + fabric, both ways
              t_cl_ps: 14000,
              t_cwl_ps: 7000,
              t_rcd_ps: 14000,
              t_rp_ps: 14000,
              t_refi_ps: 3900000,         // 0: no refresh
              t_rfc_ps: 350000,
              max_reads: 64,
              max_writes: 64
            }
          },
        ],
        bender_target: ["hemaia_mem_chip"]
      }
    }
    addr_width: 48,
    data_width: 64,
    // XBARs
    wide_xbar: {
      max_slv_trans: 64,
      max_mst_trans: 64,
      fall_through: false,
    },
    quadrant_inter_xbar_slv_id_width_no_rocache: 3,
    quadrant_inter_xbar: {
      max_slv_trans: 64,
      max_mst_trans: 64,
      fall_through: false,
    },
    narrow_xbar: {
      max_slv_trans: 32,
      max_mst_trans: 32,
      fall_through: false,
    },
    cuts: {
      soc_to_router: 1,
      router_to_soc: 1,
      narrow_to_quad: 3,
      quad_to_narrow: 3,
      wide_to_quad: 3,
      quad_to_wide: 3,
      narrow_to_cva6: 2,
      narrow_conv_to_spm_narrow: 1,
      narrow_and_wide: 1,
      wide_to_hemaia_mem: 1,
      narrow_to_hemaia_mem: 1,
      hemaia_mem_to_wide: 1,
      hemaia_mem_to_narrow: 1,
      wide_to_wide_zero_mem: 0,
      atomic_adapter_narrow: 1,
      atomic_adapter_narrow_wide: 1,
      // Give some flexibility in peripheral xbar placement
      periph_axi_lite_narrow: 2,
      periph_axi_lite: 2,
      // Non-right-side chip peripherals
      periph_axi_lite_narrow_hemaia_clk_rst_controller_cfg: 3,
      periph_axi_lite_narrow_bootrom_cfg: 3,
      // Right-side or latency-invariant chip peripherals
      periph_axi_lite_narrow_soc_ctrl_cfg: 1,
      periph_axi_lite_narrow_uart_cfg: 1,
      periph_axi_lite_narrow_i2c_cfg: 1,
      periph_axi_lite_narrow_gpio_cfg: 1,
      periph_axi_lite_narrow_clint_cfg: 1,
      periph_axi_lite_narrow_plic_cfg: 1,
      periph_axi_lite_narrow_spim_cfg: 1,
      periph_axi_lite_narrow_timer_cfg: 1,
      periph_axi_lite_narrow_d2d_link_cfg: 1,
    },
    txns: {
      narrow_and_wide: 16,
    },
    narrow_xbar_slv_id_width: 4,
    narrow_xbar_user_width: 3, // clog2(total number of clusters)
    nr_s1_quadrant: 1,
    s1_quadrant: {
      // number of pending transactions on the narrow/wide network
      narrow_trans: 32,
      wide_trans: 32,
      wide_xbar: {
        max_slv_trans: 32,
        max_mst_trans: 32,
        fall_through: false,
      },
      wide_xbar_slv_id_width: 3
      narrow_xbar: {
        max_slv_trans: 8,
        max_mst_trans: 8,
        fall_through: false,
      },
      narrow_xbar_slv_id_width: 4,
      narrow_xbar_user_width: 3, // clog2(total number of clusters)
      quad_axi_lite_narrow_base_addr: 184549376, // 0x0b000000
      quad_axi_lite_narrow_base_offset: 65536 // 0x10000
      quad_axi_lite_base_addr: 167772160, // 0x0a000000
      quad_axi_lite_base_offset: 65536 // 0x10000
      bingo_cfg: {
        dep_tag_width: 4
        task_id_width: 16
        task_desc_width: 128
        waiting_queue_depth: 32
      },
    },
    clusters:[
      "snax_split_cluster",
      "snax_split_cluster",
      "snax_split_cluster",
      "snax_split_cluster",
      ],

    hemaia_xdma_cfg: {
      bender_target: ["hemaia_xdma"],
      // ReqrspManager Cfg
      cfg_io_width: 64,
      // Cross Cluster Calling Cfg
      max_multicast: 2,
      max_dimension: 5,
      max_mem_size_kiB: 4096,
      // DataMaestro Cfg
      reader_buffer: 4,
      writer_buffer: 4,
      reader_agu_temporal_dimension: 5,
      writer_agu_temporal_dimension: 5,
      // Extension Cfg
      writer_extensions: {},
      reader_extensions: {}
    },


    // peripherals
    peripherals: {
        rom: {
            address: 16777216, // 0x0100_0000
            length: 131072, // 128 kiB 0x2_0000
        },
        clint: {
                    address: 67108864, // 0x0400_0000
                    length: 1048576, // 1 MiB 0x10_0000
        },
        axi_lite_peripherals: [
            {
                name: "debug",
                address: 0, // 0x0000_0000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "h2h_mailbox",
                address: 4096, // 0x0000_1000
                length: 4096, // 4 kiB 0x1000
            },
        ],
        axi_lite_narrow_peripherals: [
            {
                name: "soc_ctrl",
                address: 33554432, // 0x0200_0000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "uart",
                address: 33562624, // 0x0200_2000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "gpio",
                address:  33566720, // 0x0200_3000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "i2c",
                address: 33570816, // 0x0200_4000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "hemaia_clk_rst_controller",
                address: 33574912, // 0x0200_5000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "timer",
                address: 33579008, // 0x0200_6000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "hemaia_d2d_link",
                address: 33583104, // 0x0200_7000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "c2h_mailbox",
                address: 33587200, // 0x0200_8000
                length: 4096, // 4 kiB 0x1000
            },
            {
                name: "spim",
                address: 50331648, // 0x0300_0000
                length: 131072, // 4 kiB 0x2_0000
            },
            {
                name: "plic",
                address: 201326592, // 0x0C00_0000
                length: 67108864, // 64 MiB 0x400_0000
            },
        ],
    },
    // non-peripheral IPs
    spm_narrow: {
      address: 1879048192, // 0x7000_0000
      length: 131072, // 128 kiB 0x2_0000
    },
    spm_wide: {
      address: 2147483648, // 0x8000_0000
      length: 16777216,    // 16 MiB 0x100_0000
      banks: 32,
    },
    wide_zero_mem: {
      address: 68719476736, // 0x10_0000_0000
      length: 8589934592, // 8 GiB 0x11_0000_0000
    },
    sys_idma_cfg: {
      address: 83886080, // 0x0500_0000
      length: 65536, // 64 kiB 0x1_0000
    },
    // backup boot address
    backup_boot_addr: 2147483648 // 0x8000_0000
}
