/*
!/Makefile
!/.gitignore

!/ci/
/ci/*
!/ci/local_ci/
/ci/local_ci/*
# One suite subdir per tapeout RTL cfg; each keeps its own driver + task list
# (the task_<idx>/ run dirs it produces stay ignored).
!/ci/local_ci/tapeout_1c/
/ci/local_ci/tapeout_1c/*
!/ci/local_ci/tapeout_1c/run_local_ci.py
!/ci/local_ci/tapeout_1c/task_local_ci.yaml
!/ci/local_ci/tapeout_1c_simd/
/ci/local_ci/tapeout_1c_simd/*
!/ci/local_ci/tapeout_1c_simd/run_local_ci.py
!/ci/local_ci/tapeout_1c_simd/task_local_ci.yaml
!/ci/local_ci/tapeout_2c/
/ci/local_ci/tapeout_2c/*
!/ci/local_ci/tapeout_2c/run_local_ci.py
!/ci/local_ci/tapeout_2c/task_local_ci.yaml
!/ci/local_ci/tapeout_2c_simd/
/ci/local_ci/tapeout_2c_simd/*
!/ci/local_ci/tapeout_2c_simd/run_local_ci.py
!/ci/local_ci/tapeout_2c_simd/task_local_ci.yaml
!/ci/git_ci/
/ci/git_ci/*
!/ci/git_ci/run_git_ci.py
!/ci/git_ci/task_git_ci.yaml
!/ci/netlist_ci/
/ci/netlist_ci/*
!/ci/netlist_ci/README.md
!/ci/netlist_ci/run_netlist_ci.py

!/sweep/
/sweep/*
!/sweep/xdma/
/sweep/xdma/*
!/sweep/xdma/run_xdma_sweep.py
!/sweep/xdma/gather_xdma_luts.py
!/sweep/xdma/xdma_lut_report.py
!/sweep/xdma/task_xdma.yaml
!/sweep/ara/
/sweep/ara/*
!/sweep/ara/run_ara_sweep.py
!/sweep/ara/gather_ara_luts.py
!/sweep/ara/ara_lut_report.py
!/sweep/ara/task_ara.yaml
!/sweep/gemm/
/sweep/gemm/*
!/sweep/gemm/run_gemm_sweep.py
!/sweep/gemm/gather_gemm_luts.py
!/sweep/gemm/task_gemm.yaml
!/sweep/simd/
/sweep/simd/*
!/sweep/simd/run_simd_sweep.py
!/sweep/simd/gather_simd_luts.py
!/sweep/simd/simd_lut_report.py
!/sweep/simd/task_simd.yaml
!/sweep/dsv2/
/sweep/dsv2/*
!/sweep/dsv2/run_dsv2_sweep.py
!/sweep/dsv2/task_dsv2.yaml
!/sweep/simd/task_simd_fused.yaml
!/sweep/fa/
/sweep/fa/*
!/sweep/fa/run_fa_sweep.py
!/sweep/fa/gather_fa_cycles.py
!/sweep/fa/task_fa.yaml
!/sweep/moe/
/sweep/moe/*
!/sweep/moe/run_moe_sweep.py
!/sweep/moe/moe_report.py
!/sweep/moe/task_moe.yaml


!/test/
/test/*
!/test/README.md
!/test/0_start_single_chiplet_sim.py
!/test/1_start_multi_chiplet_sim.py
!/test/2_start_tapeout_sim.py

# The ISCA isolated-experiment sweeps: hsweep (sweep/common) and one directory per experiment.
# Scripts, point files and READMEs are kept; runs, builds, events, results and figures stay
# ignored.
!/sweep/common/
/sweep/common/*
!/sweep/common/hsweep.py
!/sweep/common/launch.sh
!/sweep/common/watch.sh
!/sweep/common/watchdog.sh
!/sweep/common/sim_watchdog.py
!/sweep/common/sim_watchdog.profiles.json
!/sweep/common/test_sim_watchdog.py
!/sweep/common/README.md
!/sweep/common/weights/
/sweep/common/weights/cache/
!/sweep/collective/
!/sweep/sync/
!/sweep/ffn/
!/sweep/l2_moe/
!/sweep/l2_fa/
/sweep/collective/runs/
/sweep/ffn/runs/
/sweep/ffn/cache/
/sweep/l2_moe/runs/
/sweep/l2_fa/runs/
/sweep/l2_fa/cache/
/sweep/*/__pycache__/
/sweep/*/results/
/sweep/*/figs/
/sweep/collective/old/
/sweep/sync/runs/
# the FFN sweep's run logs, and the podman / python shims of one machine
/sweep/ffn/PROGRESS.md
/sweep/ffn/HANDOFF.md
/sweep/ffn/tools/bin/
