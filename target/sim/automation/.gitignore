/*
!/Makefile
!/.gitignore
!/clean_stale.py

!/ci/
/ci/*
!/ci/local_ci/
/ci/local_ci/*
# One suite subdir per tapeout RTL cfg; each keeps its own driver + task list
# (the task_<idx>/ run dirs it produces stay ignored).
!/ci/local_ci/tapeout_1c/
/ci/local_ci/tapeout_1c/*
!/ci/local_ci/tapeout_1c/run_local_ci.py
!/ci/local_ci/tapeout_1c/task_local_ci.yaml
!/ci/local_ci/tapeout_1c_simd/
/ci/local_ci/tapeout_1c_simd/*
!/ci/local_ci/tapeout_1c_simd/run_local_ci.py
!/ci/local_ci/tapeout_1c_simd/task_local_ci.yaml
!/ci/local_ci/tapeout_2c/
/ci/local_ci/tapeout_2c/*
!/ci/local_ci/tapeout_2c/run_local_ci.py
!/ci/local_ci/tapeout_2c/task_local_ci.yaml
!/ci/local_ci/tapeout_2c_simd/
/ci/local_ci/tapeout_2c_simd/*
!/ci/local_ci/tapeout_2c_simd/run_local_ci.py
!/ci/local_ci/tapeout_2c_simd/task_local_ci.yaml
!/ci/git_ci/
/ci/git_ci/*
!/ci/git_ci/run_git_ci.py
!/ci/git_ci/task_git_ci.yaml
!/ci/netlist_ci/
/ci/netlist_ci/*
!/ci/netlist_ci/README.md
!/ci/netlist_ci/run_netlist_ci.py

!/sweep/
/sweep/*
!/sweep/README.md

# unit_test/: the per-block op-cost and LUT sweeps (the sim runner's task flows). Their scripts and
# task lists are kept; task_<n>/ run dirs, summaries and LUT outputs stay ignored.
!/sweep/unit_test/
/sweep/unit_test/*
!/sweep/unit_test/xdma/
/sweep/unit_test/xdma/*
!/sweep/unit_test/xdma/run_xdma_sweep.py
!/sweep/unit_test/xdma/gather_xdma_luts.py
!/sweep/unit_test/xdma/xdma_lut_report.py
!/sweep/unit_test/xdma/task_xdma.yaml
!/sweep/unit_test/ara/
/sweep/unit_test/ara/*
!/sweep/unit_test/ara/run_ara_sweep.py
!/sweep/unit_test/ara/gather_ara_luts.py
!/sweep/unit_test/ara/ara_lut_report.py
!/sweep/unit_test/ara/task_ara.yaml
!/sweep/unit_test/gemm/
/sweep/unit_test/gemm/*
!/sweep/unit_test/gemm/run_gemm_sweep.py
!/sweep/unit_test/gemm/gather_gemm_luts.py
!/sweep/unit_test/gemm/task_gemm.yaml
!/sweep/unit_test/simd/
/sweep/unit_test/simd/*
!/sweep/unit_test/simd/run_simd_sweep.py
!/sweep/unit_test/simd/gather_simd_luts.py
!/sweep/unit_test/simd/simd_lut_report.py
!/sweep/unit_test/simd/task_simd.yaml
!/sweep/unit_test/simd/task_simd_fused.yaml
!/sweep/unit_test/versacore/
/sweep/unit_test/versacore/*
!/sweep/unit_test/versacore/.gitignore
!/sweep/unit_test/versacore/testing_launch.py
!/sweep/unit_test/versacore/testing_workload_gen.py
!/sweep/unit_test/versacore/versacore_params.py

# llm_layer/: whole-layer runs (the sim runner's task flow).
!/sweep/llm_layer/
/sweep/llm_layer/*
!/sweep/llm_layer/dsv2/
/sweep/llm_layer/dsv2/*
!/sweep/llm_layer/dsv2/run_dsv2_sweep.py
!/sweep/llm_layer/dsv2/task_dsv2.yaml
# misc/: one-off benchmarks, nothing tracked.

!/test/
/test/*
!/test/README.md
!/test/0_start_single_chiplet_sim.py
!/test/1_start_multi_chiplet_sim.py
!/test/2_start_tapeout_sim.py

# The ISCA isolated-experiment sweeps: hsweep (sweep/common) and one directory per experiment,
# grouped as sop_ubench/ (system-of-packages microbenchmarks) and llm_blocks/. Scripts, point
# files and READMEs are kept; runs, builds, events, caches, results and figures stay ignored.
!/sweep/common/
/sweep/common/*
!/sweep/common/hsweep.py
!/sweep/common/launch.sh
!/sweep/common/watch.sh
!/sweep/common/watchdog.sh
!/sweep/common/sim_watchdog.py
!/sweep/common/sim_watchdog.profiles.json
!/sweep/common/test_sim_watchdog.py
!/sweep/common/README.md
!/sweep/common/weights/
/sweep/common/weights/cache/
!/sweep/sop_ubench/
!/sweep/llm_blocks/
/sweep/*/*/runs/
/sweep/*/*/cache/
/sweep/*/*/results/
/sweep/*/*/figs/
/sweep/**/__pycache__/
/sweep/sop_ubench/collective/old/
# the FFN sweep's run logs, and the podman / python shims of one machine
/sweep/llm_blocks/ffn/PROGRESS.md
/sweep/llm_blocks/ffn/HANDOFF.md
/sweep/llm_blocks/ffn/tools/bin/
