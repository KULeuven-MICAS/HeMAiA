{
    // Must match the HW platform's N_CLUSTERS_PER_CHIPLET exactly (the generator's
    // platform guard skips the workload otherwise). P=2 only ever uses clusters 0
    // and 1, so 2 is its natural target and lets it run on the PROVEN 2-cluster
    // single-chip cfgs (hemaia_ci-derived hemaia_xdma_rr_2c).
    //
    // NOTE (2026-07-20): this was 4, to match hemaia_xdma_rr.hjson. That cfg is
    // 4-cluster + single_chip:true -- a combination NO CI cfg exercises, and it
    // HANGS every workload run on it (an unrelated 4-cluster gemm workload hangs
    // identically): a host icache-refill AXI read never receives its R response,
    // so the icache jams in state MISS, the frontend starves and the core wedges.
    // See tmp/f3-remote-write-hang-debug-2026-07-20.md 6a.5.
    num_clusters: 2
}
