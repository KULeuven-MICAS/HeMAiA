{
    num_clusters: 4
    // Bytes per transfer. Large enough that the per-task BINGO dispatch is ~10% of the
    // transfer, so the number being measured is the port and not the manager.
    xfer_bytes: 64 * 1024
    // Transfers per cluster per phase.
    reps: 3
}
