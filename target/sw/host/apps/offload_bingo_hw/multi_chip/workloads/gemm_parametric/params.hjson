# Default configuration: 64 workers on 16 chiplets x 4 clusters, small matrix.
# RTL cfg: hemaia_scalability_exp_16chip_4c_4mem.hjson
#
# params/ holds the validated configurations; the CI task lists select one with
# HOST_DATA_CFG rather than editing this file.
{
    num_chips: 16
    clusters_per_chip: 4
    grid_M: 4
    grid_K: 4
    grid_N: 4
    array_shape: 1
    M1: 4
    K1: 4
    N1: 4
    transposed_A: 0
    transposed_B: 0
    accumPrevC: 0
    check_bytes: 0
}
