// base: the FA prefill ablation's baseline. Llama-3-8B's attention over a fresh 1,024-token prompt (16 passes of 64),
// fa/llama3_prefill/t1024's mapping and buffers (its run stg_llama3_t1024_1 is the ladder's last rung) without the
// levers that overlap kernels: each pass's x put into every chip's L3 by the memory chip's push engine one chip at a
// time and every head's o8 by one flagged put a chip from the root (x_cast unicast); a point-to-point software chip
// barrier after every kernel of a pass, fencing every core of the chip (sync barrier, barrier_mode sw).
// The driver is ../../../llama3/common/llama3_stages_mc.py (llama3_attn_mc.py, THE ABLATION).
{
  num_chiplets: 16
  num_clusters: 2
  tokens: 1024
  rows: 64
  bc: 64
  dn_cols: 256
  wbits: 4
  w4_paired: true
  w_chunk_bytes: 65536
  w_buffers: 2
  wo_cols: true
  wo_slice: 128
  rope_pairs: chunks
  restream: true
  l3_overlay: false
  kv_split: true
  weight_ring: { slots: 8, head: 4, batch_head: 1 }
  bcast: bcast_l1
  reduce: chain
  sync: barrier
  barrier_mode: sw
  x_cast: unicast
  per_chip_image: true
  desc_in_image: true
  remote_broadcast: false
  // the root cluster 0's first query tile and the pass's 64 keys (rows 16-63 are what tile 0 of y never reads),
  // then every pass's y at its head, middle and tail
  checks: stages
  mask_c: true,
  // x from HBM with the first chunks of each of the root's rings ahead of its multicasts (x_pf_split), the sweep's o~
  // straight into o8 and its geometry on the xDMA, W_O by columns with the weights loaded ahead and the gather on the
  // xDMA (no o_overlap: in the block, pass i + 1's o8 waits for that pass's x fetch, which follows pass i's y stores
  // on the DM core, so o_overlap's order closes a cycle)
  x_bcast: "memchip",
  x_pf_split: true,
  ot8_fused: true,
  sm_geom_xdma: true,
  y_scatter: true,
  o_get_xdma: true,
  x_row_tiles: true,
  fast_host_init: true,
}
