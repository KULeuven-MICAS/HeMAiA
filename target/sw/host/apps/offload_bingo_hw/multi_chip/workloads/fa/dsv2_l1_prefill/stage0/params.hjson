// stage0 (main_bingo.py): stage 0 of the DSv2 MLA fresh prefill alone, x from the root memory chip's HBM into every
// chip's L3. The sizes are the whole block's (the block's image: ../full_n).
{
  // the platform: 16 compute chips of two clusters
  "num_chiplets": 16,
  "num_clusters": 2,
  // the prompt, its 128-token chunks and the sweep's 64-key tiles
  "tokens": 256,
  "chunk": 128,
  "bc": 64,
  // INT4 weights; a weight chunk's bytes, the L1 slabs a cluster streams through, the ring's slots
  "wbits": 4,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {"slots": 6},
  // the program image: each chip's own tables, its task descriptors read from the image, the L1 order searched
  "per_chip_image": true,
  "desc_in_image": true,
  "l1_order": "search"
}
