// stage3: the keys to every chip, alone (common/fa_stages_mc.py stage 3): each owner's 17 KB piece in its L1 before
// the window; production route: the pieces into the root's L3, the root multicasts a chunk's pieces at a time.
{
  "stage": 3,
  "x_hbm": true,
  "split_loads": false,
  "split_frac": 0.5,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "per_chip_image": true,
  "desc_in_image": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "y_store_halves": false,
  "y_windows": 4,
  "kv_slabs": "split",
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4
}
