# Generated by each workload's main_bingo.py through common/fa.mk (`make clean` removes them); the
# HBM image in build/ is ignored globally.
*/*/*.png
*/*/*.h
*/*/*.csv
*/*/block_dfg/
__pycache__/

# Intermediate experiments are not tracked: a numbered variant (v<N>) is one iteration of a
# workload; the named ones (base, all, ...) are the variants that stay.
*/v[0-9]*/
