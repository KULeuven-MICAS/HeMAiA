// stage1: stage 0 + the keys by columns (common/fa_stages_mc.py), the optimised mapping. X multicast by the root's
// memory chip (x_bcast memchip), the root's W_KVA pushed before it on the shared engine (x_bcast_after_prefetch),
// every other chip's at once. Each cluster copies its chip's W_KVA pair into L1 first (kv_wkva_first), then each of
// its tiles of X as it lands, 70 % by the iDMA and 30 % by the xDMA (split_loads, split_frac 0.3); a GEMM a tile; each
// [16 x 32] slice into the tile owner's L3 behind a flag. 0x41 and 0x43, two INT4 pairs each, make their second pair
// for tiles 0-3 only; three chips of each one's row make it for tiles 4-7, 8-11 and 12-15 (kv_balance,
// kv_balance_ways 4). Every owner waits for its tile's slices.
{
  "stage": 1,
  "x_hbm": true,
  "x_bcast": "memchip",
  "kv_balance_ways": 4,
  "kv_wkva_first": true,
  "kv_balance": true,
  "x_bcast_after_prefetch": true,
  "split_loads": true,
  "split_frac": 0.3,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "static_l1": true,
  "l1_capacity": 960000,
  "compact_id_maps": true,
  "gid_lists": true,
  "per_chip_image": true,
  "desc_in_image": true,
  "d2d_ddr": true,
  "d2d_rx_yield": [
    255,
    0
  ],
  "relay_per_gather": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
    "batch": 4,
    "policy": 1
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "gemm_async": true,
  "l3_overlay": true,
  "x_puts_first": true,
  "y_halves": false,
  "y_store_halves": false,
  "y_windows": 4,
  "kv_slabs": "split",
  "prefetch_after_x": false,
  "chain_concurrent": false,
  "checks": "y",
  "cfg_reuse": true,
  "gemm_shape_l1": true,
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "gemm_reuse": true,
  "mask_c": true,
  "gemm_cfg_ahead": true,
  "fa_cfg_ahead": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4
}
