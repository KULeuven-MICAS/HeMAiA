// stage0123 (main_bingo.py): stages 0 to 3 of the DSv2 MLA fresh prefill chained: x from HBM, the keys by columns
// (the INT4 pairs balanced over helper chips), the owners' pieces and their multicasts into every chip. The sizes are
// the whole block's (the block's image: ../full_n).
{
  // the platform: 16 compute chips of two clusters
  "num_chiplets": 16,
  "num_clusters": 2,
  // the prompt, its 128-token chunks and the sweep's 64-key tiles
  "tokens": 256,
  "chunk": 128,
  "bc": 64,
  // INT4 weights; a weight chunk's bytes, the L1 slabs a cluster streams through, the ring's slots
  "wbits": 4,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {"slots": 6},
  // the program image: each chip's own tables, its task descriptors read from the image, the L1 order searched
  "per_chip_image": true,
  "desc_in_image": true,
  "l1_order": "search"
}
