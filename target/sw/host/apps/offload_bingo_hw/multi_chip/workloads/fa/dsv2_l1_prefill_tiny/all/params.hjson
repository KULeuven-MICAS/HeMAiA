// DeepSeek-V2-Lite layer 1's MLA attention over the first 1,024 keys of the latent cache, 256-token proof of concept, 4 chunks of 64 tokens, head parallel (chip = head,
// cluster = half of a chunk's tokens: two 16-row query tiles), K/V tiles of 256 keys, INT8, on
// hemaia_16c4m_8MBL3_2cluster.
// Variant all: x and the cache multicast; every chunk's partials folded in transit (xDMA ChainGather); cross-chip dependencies in the BINGO hardware scheduler (per edge), so a chunk's reduce and the next chunk's x run under the next sweep.
// L3: the ring holds 6 slots and y overlays the x buffers (l3_overlay); with 16 slots and its own y the
// image overflows the 8 MiB L3.
// What each field does is in ../../common/fa_prefill_mc.py.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l1
  tokens: 256
  chunk: 64
  keys: 1024
  bc: 256
  w_chunk_bytes: 147456
  w_buffers: 4
  weight_ring:
  {
    slots: 6
    batch: 4
    policy: 1
  }
  weight_crest: false
  bcast: bcast_l1
  reduce: chain
  sync: edge
  gemm_async: true
  l3_overlay: true
  static_l1: true
  l1_capacity: 990000
  d2d_ddr: true
}
