// fa/llama3_decode_full/bcast: the FA decode ablation on the whole attention block of Llama-3-8B (32 query / 8 key-value
// heads of 128, hidden 4096, synthetic INT4 weights): one decode token over an 8,192-position KV cache, x from the root
// memory chip's HBM through the q / k / v GEMVs, the key-split attention, W_O, y written back to HBM and the new key
// and value appended to the cache in HBM. Rung bcast: base with x multicast by the memory chip and the q halves, m* and o by the root (+ broadcast).
// ../../../llama3/common/llama3_decode_ks_mc.py explains the mapping and every parameter (THE ABLATION).
{
  num_chiplets: 16
  num_clusters: 2
  tokens: 1
  // the cached positions (128 key tiles of 64, 8 a chip) and the prefill's passes of 64 queries the golden runs over
  // them for the prompt's static scales
  ctx: 8192
  rows: 64
  bc: 64
  wbits: 4
  w4_paired: true
  w_chunk_bytes: 65536
  // the 4 W_O chunks of a cluster wait in its slabs for o (wo_push before_chains)
  w_buffers: 4
  weight_ring: { slots: 8, head: 4, batch_head: 1 }
  bcast: bcast_l1
  reduce: root
  sync: barrier
  barrier_mode: sw
  x_cast: multicast
  per_chip_image: true
  desc_in_image: true
  d2d_rx_yield: [255, 0]
  remote_broadcast: false
  fast_host_init: true
  x_bcast: "memchip",
  // the FA core's variant: one pass, the clusters' (m, l) merged by the softmax-statistics junction (with reduce root
  // the root takes the maxima and the row sums are reduced with O)
  passes: 1
  stats: merge
  // each chip's W_O pushes right behind its k / v chunks, during the sweep; the statistics wait until the chip has
  // loaded its last W_O chunk: no ChainGather and no o multicast beside a push
  wo_push: before_chains
  // each chip's cache copy waits until q is in every cluster: no cache copy beside the W_q streams or q's multicast
  cache_order: after_q
  // the query halves, the root's m*, a far chip's partial before y and the appends; y and the appends copied from
  // HBM into the root's L3 first
  checks: stages
  hbm_checks: stash
}
