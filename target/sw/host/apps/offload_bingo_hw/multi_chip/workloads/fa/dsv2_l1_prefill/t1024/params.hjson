// t1024: DeepSeek-V2-Lite's layer-1 MLA attention over a fresh 1,024-token prompt, all eight chunks
// (common/fa_stages_mc): full_n's mapping, each chunk's keys just ahead of its queries (keys_by_chunk)
// and each W_O block's chains folding into a collector chip in turn (y_roots).
{
  "skip_masked": true,
  "row_swap": true,
  "kv_balance_ways": 4,
  "kv_balance": true,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 1024,
  "per_chip_image": true,
  "desc_in_image": true,
  "chunk": 128,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {"slots": 6},
  // the odd key tiles in a one-tile buffer of their own (a fourth K buffer, not a fourth ring slab)
  "kv_slabs": "split_kb",
  "chain_concurrent": false,
  "checks": "y",
  "l1_order": "search",
  "wbits": 4,
  "x_pf_split": true,
  // the root clusters' chains and stores of chunk i - 1 behind their sweep of chunk i in their cores' programs
  "chains_after_sweep": true,
  // each chunk's keys just ahead of its queries (stages 1-3 of chunk h behind chunk h - 1's stage 4; the root's host:
  // W_KVA, chunk 0's x, chunk 0's stage-4 weights, the rest of x, the rest); no wait for every key
  "keys_by_chunk": true,
  "full_kv_all": false,
  // each W_O block's chains fold into a collector chip in turn, not the root; the chains' dep-tag relays on the DM core
  // (relay_prefer); the host's tables as static images (fast_host_init)
  "y_roots": ["11", "31", "13", "33"],
  "relay_prefer": {"xdma": ["dm"]},
  "fast_host_init": true,
  // stage 4: the SIMD core quantises the query tiles tile by tile (q~, then q_pe), so the sweep's first QK waits for
  // one tile's quantisations
  "s4_q8_pairs": 2,
  // a collector cluster's store of chunk i's y block behind its own load of chunk i + 1's key tile 2's values, so its
  // chunk i + 1 front does not wait for the chain the store waits for
  "yr_store_tile": 2,
  // o's relayout and quantisation a query tile at a time behind its W_UV GEMM; W_O as GEMMs of two row tiles, each
  // waiting for its own two tiles' o8 only (wo_split_rows, wo_row_pipe)
  "post_tiles": true,
  "wo_split_rows": true,
  "wo_row_pipe": true,
  // kc_xs_late: a helping chip's tiles after the window load their own copy of the helped W_KVA slice, which frees the
  // window's copy; kx_mid_double: chunk 1's key tiles double-buffered; yr_rel1: on the collectors of chunk i - 1, chunk
  // i's ring chunks are released by cluster 1's read
  "kc_xs_late": true,
  "kx_mid_double": true,
  "yr_rel1": true,
  // the rest of x (chunks 2 on) behind chunk 0's key multicast and ahead of the rest of the root's ring, not behind its
  // last run (behind it, a full block's chunk 2 never gets its x)
  "x_rest_early": true,
  // each chunk's key tiles in buffers (and W_KVA / helped-pair copies) of their own, behind the chunk before's q
  // projections, so the key loop never sits beside a collector's held y block in L1
  "kx_per_chunk": true,
  // every cluster's key loop of chunk h behind its chunk h - 1 tile-2 value load and the last chain of chunk h - 2, so
  // no key transfer runs beside a reduce chain
  "kx_after_chains": true
}
