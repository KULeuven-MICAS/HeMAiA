// t1024: DeepSeek-V2-Lite's layer-1 MLA attention over a fresh 1,024-token prompt, all eight chunks, with the switches
// of the proof of concept fa/dsv2_l1_prefill_poc/t1024_ab_yrphswk and x_rest_early.
{
  "stage": "full",
  "s4_reorder": true,
  "s4_tile_absorb": true,
  "s4_overlap": true,
  "skip_masked": true,
  "row_swap": true,
  "ot8_fused": true,
  "kv_norm_fused": true,
  "kv_split_clusters": true,
  "kv_vals_other": true,
  "kv_vals_own": true,
  "x_hbm": true,
  "x_bcast": "memchip",
  "kv_balance_ways": 4,
  "kv_wkva_first": true,
  "kv_balance": true,
  "split_loads": true,
  "split_frac": 0.3,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 1024,
  "per_chip_image": true,
  "desc_in_image": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 1024,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "y_store_halves": true,
  "y_windows": 4,
  "kv_slabs": "split_kb",
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4,
  "reduce_early": true,
  "last_pair_chains": true,
  "x_pf_split": true,
  "sm_geom_xdma": true,
  // lever A (the FA tracker's roofline section): the root clusters' chains and stores of chunk i - 1 behind their
  // sweep of chunk i in their cores' programs
  "chains_after_sweep": true,
  // lever B: each chunk's keys just ahead of its queries (stages 1-3 of chunk h behind chunk h - 1's stage 4; the
  // root's host: W_KVA, chunk 0's x, chunk 0's stage-4 weights, the rest of x, the rest); no wait for every key
  "keys_by_chunk": true,
  "full_kv_all": false,
  // each W_O block's chains fold into a collector chip in turn, not the root (y_roots; snax replays rd_abyr /
  // rd_abyr11: C00 cl0's chunk 1 done 80.8k cc before A's); the chains' dep-tag relays on the DM core; the host's
  // tables as static images
  "y_roots": ["11", "31", "13", "33"],
  "relay_prefer": {"xdma": ["dm"]},
  "fast_host_init": true,
  // stage 4: q_pe's relayout ahead of q~ tile 2's on the xDMA core, and the SIMD core quantises tile by tile (q~,
  // then q_pe), so the sweep's first QK waits for one tile's quantisations (snax replays rd_abyrp / rd_abyrp11)
  "s4_q8_pairs": 2,
  // each projection GEMM's configure task ahead of the waits right before its start, so a phase's first configure
  // (W_UV after the sweep, W_O, the next chunk's q) runs under the last GEMM, not after it (snax replays rd_abyrph /
  // rd_abyrph11)
  // a collector cluster's store of chunk i's y block behind its own load of chunk i + 1's key tile 2's values, so its
  // chunk i + 1 front does not wait for the chain the store waits for (gated snax replays rd_yrg11 / rd_yrgs11)
  "yr_store_tile": 2,
  // o's relayout and quantisation a query tile at a time behind its W_UV GEMM, W_O as GEMMs of two row tiles, each
  // waiting for its own two tiles' o8 only (snax replay rd_abyrpw)
  "post_tiles": true,
  "wo_split_rows": true,
  "wo_row_pipe": true,
  // kv_slabs split_kb: the odd key tiles in a one-tile buffer of their own (a fourth K buffer, not a fourth ring slab);
  // kc_xs_late: a helping chip's after-window tiles load their own helped W_KVA slice, which frees the window's copy;
  // kx_mid_double + kx_ahead: chunk 1's key tiles double-buffered, each load ahead of the previous tile's put;
  // yr_rel1: on the collectors of chunk i - 1, chunk i's ring chunks are released by cluster 1's read
  // (snax replays rd_r2all / rd_r2all_11)
  "kc_xs_late": true,
  "kx_mid_double": true,
  "yr_rel1": true,
  // x_rest_early: the rest of x (chunks 2 on) behind chunk 0's key multicast and ahead of the rest of the root's
  // ring, not behind its last run (behind it, a full block's chunk 2 never gets its x)
  "x_rest_early": true,
  // kx_per_chunk: each chunk's key tiles in buffers (and W_KVA / helped-pair copies) of their own, behind the chunk
  // before's q projections, so the key loop never sits beside a collector's held y block in L1
  "kx_per_chunk": true,
  // kx_after_chains: every cluster's key loop of chunk h behind its chunk h - 1 tile-2 value load and the last chain
  // of chunk h - 2, so no key transfer runs beside a reduce chain (stg_dsv2poc_t1024_c3 hung with them together)
  "kx_after_chains": true,
}
