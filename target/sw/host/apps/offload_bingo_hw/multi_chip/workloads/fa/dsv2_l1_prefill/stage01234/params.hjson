// stage01234: the stage's optimal mapping (28 Oct), was stage01234_p (measured as run stg_fresh_stage01234_p: 240.8 us, 9/9 PASS).
// stage01234: stages 0 to 4 chained, as the full chain makes them (full's mapping), the window ending when every
// cluster's Q8 of both chunks is in L1: the ring carries the head's weights only. The baseline for s4_early.
{
  "stage": "full",
  "stop": "q8",
  "s4_reorder": true,
  "s4_tile_absorb": true,
  "s4_overlap": true,
  "skip_masked": true,
  "row_swap": true,
  "ot8_fused": true,
  "kv_norm_fused": true,
  "kv_split_clusters": true,
  "kv_vals_other": true,
  "kv_vals_own": true,
  "x_hbm": true,
  "x_bcast": "memchip",
  "kv_balance_ways": 4,
  "kv_wkva_first": true,
  "kv_balance": true,
  "split_loads": true,
  "split_frac": 0.3,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "per_chip_image": true,
  "desc_in_image": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "y_store_halves": true,
  "y_windows": 4,
  "kv_slabs": "split",
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4,
  "reduce_early": false,
  "last_pair_chains": true,
  "x_pf_split": true
}
