// stage01234: stages 0 to 4 chained, as the full chain makes them (full_n's mapping), the window ending when every
// cluster's Q8 of both chunks is in L1 (stop q8): the ring carries the head's weights only.
{
  "stop": "q8",
  "skip_masked": true,
  "row_swap": true,
  "kv_balance_ways": 4,
  "kv_balance": true,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "per_chip_image": true,
  "desc_in_image": true,
  "chunk": 128,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {"slots": 6},
  "kv_slabs": "split",
  "chain_concurrent": false,
  "checks": "y",
  "l1_order": "search",
  "wbits": 4,
  "x_pf_split": true
}
