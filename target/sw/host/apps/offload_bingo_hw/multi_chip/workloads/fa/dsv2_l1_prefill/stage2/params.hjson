// stage2: the owner finishes a key tile, alone, the optimised mapping (common/fa_stages_mc.py stage 2): c on the
// tile's cluster (RMSNorm row_major -> A, INT8), the value columns and k_pe on the other, which builds c^T itself
// (RMSNorm col_major -> B, INT8), each single-launch SIMD / xDMA task configured ahead. Run stg_fresh_stage2_nvo.
{
  "stage": 2,
  "kv_norm_fused": true,
  "kv_split_clusters": true,
  "kv_vals_other": true,
  "kv_vals_own": true,
  "x_hbm": true,
  "split_loads": false,
  "split_frac": 0.5,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "per_chip_image": true,
  "desc_in_image": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "y_store_halves": false,
  "y_windows": 4,
  "kv_slabs": "split",
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4
}
