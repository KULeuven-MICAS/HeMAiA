// full_n: full (= full_v3) + this round's stage winners: x_pf_split (stages 0-4 chained 267.0 -> 240.8 us: the root's
// W_KVA ring chunk before the X multicast, the rest after) + sm_geom_xdma (stage 5 73.9 -> 70.65 us: each arena's
// softmax geometry on the xDMA core; prime_fa_softmax CSR-primes those softmaxes).
// full, the best full chain (measured as run stg_fresh_full_v3): as below + last_pair_chains (the last chunk's two clusters' reduce chains of a W_O block at the same time,
// once every chip's prefetcher is done; the blocks in series).
// full_v2: full + the stage 4-8 levers of 28 Oct: s4_reorder, s4_tile_absorb, s4_overlap (a chunk's rows land
// without waiting for the previous chunk's sweep readers), skip_masked + row_swap (no wholly masked key tile; the
// clusters take the other halves in chunk 1), ot8_fused (the sweep's normalisation quantises o~ into W_UV's A operand).
// full: the whole DSv2-Lite MLA fresh prefill block (T=256), stages 0 to 3 as optimised in the stage workloads (X from
// HBM by the memory chip's multicast, the keys by columns with kv_balance, the owners' two clusters, C00's chunk
// multicasts), stages 4 to 8 as t256_m_all_w4_re (reduce_early, y_store_halves): the comparison with that run.
{
  "stage": "full",
  "s4_reorder": true,
  "s4_tile_absorb": true,
  "s4_overlap": true,
  "skip_masked": true,
  "row_swap": true,
  "ot8_fused": true,
  "kv_norm_fused": true,
  "kv_split_clusters": true,
  "kv_vals_other": true,
  "kv_vals_own": true,
  "x_hbm": true,
  "x_bcast": "memchip",
  "kv_balance_ways": 4,
  "kv_wkva_first": true,
  "kv_balance": true,
  "x_bcast_after_prefetch": false,
  "split_loads": true,
  "split_frac": 0.3,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "static_l1": true,
  "l1_capacity": 960000,
  "compact_id_maps": true,
  "gid_lists": true,
  "per_chip_image": true,
  "desc_in_image": true,
  "d2d_ddr": true,
  "d2d_rx_yield": [
    255,
    0
  ],
  "relay_per_gather": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 6,
    "batch": 4,
    "policy": 1
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "x_puts_first": true,
  "y_halves": false,
  "y_store_halves": true,
  "y_windows": 4,
  "kv_slabs": "split",
  "prefetch_after_x": false,
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4,
  "reduce_early": true,
  "last_pair_chains": true,
  "x_pf_split": true,
  "sm_geom_xdma": true
}
