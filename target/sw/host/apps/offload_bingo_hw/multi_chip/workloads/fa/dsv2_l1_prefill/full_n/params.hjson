// full_n: the whole DSv2-Lite layer-1 MLA fresh prefill block over 256 tokens (common/fa_stages_mc):
// stages 0 to 3 as the stage workloads make them (x from HBM by the memory chip's multicast, the keys by columns with
// kv_balance, the owners' two clusters, the root's chunk multicasts), then per chunk the queries, the sweep, W_UV, W_O
// and one reduce chain a W_O block, the last chunk's two clusters' chains at the same time. x_pf_split: the root's
// W_KVA ring run ahead of x's multicast in its memory chip's engine queue, the rest of its ring after it.
{
  "skip_masked": true,
  "row_swap": true,
  "kv_balance_ways": 4,
  "kv_balance": true,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "per_chip_image": true,
  "desc_in_image": true,
  "chunk": 128,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {"slots": 6},
  "kv_slabs": "split",
  "chain_concurrent": false,
  "checks": "y",
  "l1_order": "search",
  "wbits": 4,
  "x_pf_split": true
}
