// stage1234 (the optimal stages 1-4; was stage1234_xpa, run stg_llama3_stage1234_xpa): stage1234_xp + x_pf_chunks 1 + x_ahead; stage1234 + + the root's prefetcher split: its pass-0 chunks before the multicasts
// stage1234: Llama-3-8B's attention, stages 1-4 alone (x, the projections, the K/V trade): its inputs in place before the window, its outputs checked
// (llama3_stages_mc.py stage "1234"); otherwise full's mapping.
{
  num_chiplets: 16
  num_clusters: 2
  seed: 1
  tokens: 256
  rows: 64
  bc: 64
  dn_cols: 256
  wbits: 4
  w4_paired: true
  w_chunk_bytes: 65536
  w_buffers: 2
  load_ahead: true
  wo_cols: true
  wo_slice: 128
  rope_pairs: chunks
  restream: true
  l3_overlay: true
  kv_split: true
  weight_ring: { slots: 8, batch: 4, policy: 1, head: 4, batch_head: 1 }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  static_l1: true
  compact_id_maps: true
  gid_lists: true
  per_chip_image: true
  desc_in_image: true
  l1_capacity: 990000
  d2d_ddr: true
  d2d_rx_yield: [255, 0]
  remote_broadcast: false
  // the root cluster 0's first query tile and the pass's 64 keys (rows 16-63 are what tile 0 of y never reads),
  // then every pass's y at its head, middle and tail
  checks: stages
  cfg_reuse: true
  gemm_shape_l1: true
  gemm_reuse: true
  gemm_cfg_ahead: true
  fa_cfg_ahead: true
  mask_c: true,
  stage: "1234",
  x_bcast: "memchip",
  x_pf_split: true,
  // as DSv2's stage01234_p: one chunk of each ring ahead of the X multicasts, the rest after
  x_pf_chunks: 1,
  // the next pass's RoPE table, first weight chunk and x fetch ahead of the K/V trade (as DSv2's s4_early)
  x_ahead: true
}
