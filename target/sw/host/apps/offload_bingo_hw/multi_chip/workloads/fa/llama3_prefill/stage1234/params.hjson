// stage1234: Llama-3-8B's attention, stages 1-4 alone (x, the projections, the K/V trade): its inputs in place before
// the window, its outputs checked (llama3_stages_mc.py stage "1234"); otherwise full's mapping, with one chunk of each
// of the root's rings ahead of the x multicasts and the next pass's x work ahead of the K/V trade.
{
  num_chiplets: 16
  num_clusters: 2
  tokens: 256
  rows: 64
  bc: 64
  dn_cols: 256
  wbits: 4
  w4_paired: true
  w_chunk_bytes: 65536
  w_buffers: 2
  wo_cols: true
  wo_slice: 128
  rope_pairs: chunks
  restream: true
  l3_overlay: true
  kv_split: true
  weight_ring: { slots: 8, head: 4, batch_head: 1 }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  per_chip_image: true
  desc_in_image: true
  remote_broadcast: false
  // the root cluster 0's first query tile and the pass's 64 keys (rows 16-63 are what tile 0 of y never reads),
  // then every pass's y at its head, middle and tail
  checks: stages
  mask_c: true,
  stage: "1234",
  x_bcast: "memchip",
  x_pf_split: true,
  // one chunk of each of the root's rings ahead of the x multicasts, the rest after the last has landed
  x_pf_chunks: 1,
  // the next pass's RoPE table, first weight chunk and x fetch ahead of the K/V trade (as DSv2's s4_early)
  x_ahead: true
}
