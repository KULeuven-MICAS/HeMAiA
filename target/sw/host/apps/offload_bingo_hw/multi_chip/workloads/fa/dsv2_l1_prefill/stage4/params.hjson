// stage4, the best of its ladder (measured as run stg_fresh_stage4_owrtq): as below + s4_q8a_first (q~'s quantisations ahead of q_pe's on the SIMD core).
// stage4_owrt: stage4_owr + s4_tile_absorb (the absorb a query tile at a time). stage4_owr: stage4 with the warm
// ring, the reorder and the overlap (round 1: split x and configure ahead
// gave nothing on top of the overlap).
{
  "stage": 4,
  "s4_warm_ring": true,
  "s4_reorder": true,
  "s4_overlap": true,
  "s4_tile_absorb": true,
  "s4_q8a_first": true,
  "x_hbm": false,
  "num_chiplets": 16,
  "num_clusters": 2,
  "tokens": 256,
  "static_l1": true,
  "l1_capacity": 960000,
  "compact_id_maps": true,
  "gid_lists": true,
  "per_chip_image": true,
  "desc_in_image": true,
  "d2d_ddr": true,
  "d2d_rx_yield": [
    255,
    0
  ],
  "relay_per_gather": true,
  "model": "dsv2-lite-l1",
  "chunk": 128,
  "fresh": true,
  "wo_cols": false,
  "keys": 256,
  "bc": 64,
  "w_chunk_bytes": 65536,
  "w_buffers": 3,
  "weight_ring": {
    "slots": 8,
    "batch": 4,
    "policy": 1
  },
  "bcast": "bcast_l1",
  "reduce": "chain",
  "sync": "edge",
  "l3_overlay": true,
  "x_puts_first": true,
  "y_halves": false,
  "y_store_halves": true,
  "y_windows": 4,
  "kv_slabs": "split",
  "prefetch_after_x": false,
  "chain_concurrent": false,
  "checks": "y",
  "rope_fused": true,
  "rope_perm": true,
  "dq_fused": true,
  "mask_c": true,
  "x_put_cluster": 1,
  "x_resident": true,
  "q_tiles": true,
  "o_tiles": true,
  "y_block_chains": true,
  "l1_order": "search",
  "kv_cols": true,
  "wbits": 4,
  "reduce_early": true
}
