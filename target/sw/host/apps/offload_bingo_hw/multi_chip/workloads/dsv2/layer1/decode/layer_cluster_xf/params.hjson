// dsv2/layer1/decode/layer_cluster: dsv2/layer1/decode/layer with every weight ring posted run by run by its
// cluster's DM core (weight_ring.mode cluster: no prefetcher task); each push engine's 32 queue entries split 16
// (attention ring) + 16 (second block's rings).
{
  // the platform and the graph's emission, shared by both blocks
  num_chiplets: 16
  num_clusters: 2
  l1_order: search
  per_chip_image: true
  desc_in_image: true
  fast_host_init: true
  d2d_rx_yield: [255, 0]
  // the key-split MLA decode (dsv2/layer1/decode/mla_ks): one cached 64-key tile a chip on its cluster 0, the
  // token's tile on C00's cluster 1, every weight multiply a GEMV; x is the input norm's a_row multicast from C00's L1
  attn:
  {
    // the step: the cached positions (the token's position); the dequantisation's calibration positions
    cache: 1024
    n_calib: 32
    // m*: one ChainGather with the FP16 MAX junction
    m_exchange: chain
    // every chain after every chip's last ring chunk has landed: no ChainGather beside a memory-chip push
    chains_after_stream: true
    // the block's own checks the layer makes (y: m*, o~, a partial, the appended piece)
    checks: y
    // one ring a chip: every chunk of both clusters in push order, each its own slot; its first 11 chunks pushed one
    // by one, then runs of 4
    w_chunk_bytes: 36864
    weight_ring:
    {
      mode: cluster
      queue: 16
      slots: 16
      batch: 4
      policy: 1
      head: 11
      batch_head: 1
    }
  }
  // the MoE decode on the GEMV (dsv2/layer1/decode/moe_gv): every chip a run of the shared MLP and routed_split-th
  // pieces of three routed experts, the routed chunks pushed once the device's route has reached the chip; one output
  // slice a cluster; at most 4 column blocks a gate|up chunk
  moe:
  {
    seed: 1
    tokens: 1
    wbits: 4
    gemv: true
    blocks: 4
    routed_split: 8
    slice: 1024
    w_chunk_bytes: 131328
    w_buffers: 2
    weight_ring:
    {
      mode: cluster
      queue: 16
      slots: 14
      batch: 4
      policy: 1
      head: 4
      batch_head: 1
      queued: true
    }
    bcast: bcast_l1
    reduce: chain
    sync: edge
    warm_root: true
    chain_tail: 1
    chain_path: ["40", "41", "42", "43", "33", "32", "31", "30", "10", "11", "12", "13", "03", "02", "01", "00"]
  }
  // the layer: the key-split attention, the second block, where the layer stops, the second block's weights pushed
  // once X's multicast is done, and its first chains after its every ring's last chunk; the attention rings of the
  // other chips the root's memory chip feeds after the input norm's HBM read
  layer:
  {
    attn: ks
    mlp: moe
    stop: full
    mlp_prefetch: after
    chains_after_stream: true
    x_load_first: true
  }
}
