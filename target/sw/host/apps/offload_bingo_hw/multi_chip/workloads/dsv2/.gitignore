# Generated by each workload's main_bingo.py through common/dsv2_prefill.mk (the HBM image goes to build/, ignored
# globally); the workloads sit at layer<N>/<app>/ and layer<N>/{decode,prefill}/<app>/, so the patterns match at any
# depth.
__pycache__/
**/*.png
**/*.h
**/*.csv
**/per_chip_ids
**/block_dfg/

# Intermediate experiments are not tracked: a numbered variant (layer<N>/layer<M>, layer<M><x>) is one iteration of the
# layer; the workloads that stay are listed in layer<N>/README.md.
layer[01]/layer[0-9]*/
