// bcast: R1, base + the broadcast: X and the router's weights by one multicast each, the route table by one multicast a row
// block (x_cast multicast); still the root's fold and a barrier after every kernel.
// DeepSeek-V2-Lite's layer-1 MoE (64 routed experts of 1,408 intermediate columns, top 6, and the shared MLP of 2,816),
// the checkpoint's weights in INT4 (the router's INT8), a fresh 512-token prompt in one pass on 16 + 4 chiplets, X from the
// root memory chip's HBM; the mapping, chunks, slices and buffers of the tuned block, ../all.
{
  stage: "full"
  num_chiplets: 16
  num_clusters: 2
  tokens: 512
  wbits: 4
  blocks: 3
  slice: 64
  x_blocks: 16
  expert_rows: 32
  w_chunk_bytes: 100352
  w_buffers: 2
  weight_ring:
  {
    slots: 18
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: root
  sync: barrier
  b_parity: true
  topk_shared: true
  warm_root: true
  dispatch_blocks: true
  route: dist
  chain_concurrent: false
  l3_overlay: true
  prefetch_after_x: true
  shared_after: [0]
  x_in_xe: true
  route_tile_buf: true
  route_early: true
  sh_quant_blocks: true
  fast_host_init: true
  desc_in_image: true
  args_phases: true
  slot_order: [1, 2, 3, 0]
  scale_out: true
  chain_first_alt: true
  chain_tail: 1
  per_chip_image: true
  chain_path: ["40", "41", "42", "43", "33", "32", "31", "30", "10", "11", "12", "13", "03", "02", "01", "00"]
  // the ablation's switches (../../common/moe_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  barrier_at: kernel
  barrier_mode: sw
}
