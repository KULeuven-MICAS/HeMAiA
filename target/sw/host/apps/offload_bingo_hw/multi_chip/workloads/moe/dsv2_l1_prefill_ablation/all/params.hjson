// all: R4, fused + per-edge synchronisation: BINGO hardware edges, no barrier (sync edge): the tuned block
// (its measured run is stg_full_t512_3).
// DeepSeek-V2-Lite's layer-1 MoE (64 routed experts of 1,408 intermediate columns, top 6, and the shared MLP of 2,816),
// the checkpoint's weights in INT4 (the router's INT8), a fresh 512-token prompt in one pass on 16 + 4 chiplets, X from the
// root memory chip's HBM; the tuned mapping, chunks, slices and buffers.
{
  num_chiplets: 16
  num_clusters: 2
  tokens: 512
  wbits: 4
  blocks: 3
  slice: 64
  x_blocks: 16
  expert_rows: 32
  w_chunk_bytes: 100352
  w_buffers: 2
  weight_ring:
  {
    slots: 18
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  shared_after: [0]
  fast_host_init: true
  desc_in_image: true
  args_phases: true
  slot_order: [1, 2, 3, 0]
  per_chip_image: true
  chain_path: ["40", "41", "42", "43", "33", "32", "31", "30", "10", "11", "12", "13", "03", "02", "01", "00"]
}
