# Generated by each workload's main_bingo.py through common/llama3.mk (`make clean` removes them); the
# HBM image in build/ is ignored globally.
*/*/*.png
*/*/*.h
*/*/*.csv
*/*/per_chip_ids
*/*/block_dfg/
__pycache__/

# Intermediate experiments are not tracked: a numbered variant (layer<N>, attn<N>, ffn<N>...) is one
# iteration of a block; ffn, attn and layer (README.md) are the variants that stay.
*/layer[0-9]*/
*/attn[0-9]*/
*/ffn[0-9]*/
