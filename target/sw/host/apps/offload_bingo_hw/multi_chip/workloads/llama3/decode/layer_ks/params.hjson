// llama3/decode/layer_ks: one Llama-3-8B decoder layer (hidden 4096, 32 query / 8 key-value heads of 128, FFN 14336,
// synthetic weights of the model's shapes, INT4) for one decode token at position 1,024 over the KV cache of positions
// 0..1,023, on 16 + 4 chiplets, in one graph, the attention split by key and every weight multiply on the one-token
// GEMV: the input RMSNorm on the root's cluster 0 (x, one FP16 row, from the root memory chip's HBM), the key-split GQA
// decode block, the glue on the root (+ x = h, RMSNorm, the FFN's INT8 X in a_row multicast from the root's L1 into
// every chip's L3), the all-GEMV FFN decode block, and the final residual on the root (Y_raw dequantised + h), whose
// row is written into the root memory chip's HBM. Weights and the KV cache stream from the memory chips' HBM; the new
// key and value are appended there at the layer's end. Each chip's FFN pushes start once its attention part has ended;
// every ChainGather runs after or before every push and every write into HBM after every collective and push (the
// generator proves both on the graph). ../../common/llama3_decode_layer_mc.py explains the layer and its parameters.
{
  num_chiplets: 16
  num_clusters: 2
  tokens: 1
  wbits: 4
  per_chip_image: true
  desc_in_image: true
  remote_broadcast: false
  fast_host_init: true
  bcast: bcast_l1
  reduce: chain
  sync: edge
  // each memory chip's push engine queue (32 entries): 12 for the attention's ring runs, 12 for the FFN's, 8 for the
  // HBM casts (the KV cache unicasts)
  hbm_cast:
  {
    queue: 8
  }
  // the key-split attention decode block (../../common/llama3_decode_ks_mc.py), as llama3/decode/attn_ks runs it: one
  // cached tile of 64 keys a chip, the new key in a 16-key tile on the root's chip, two passes, the row maxima met by
  // the FP16 MAX junction, each chip's W_O pushes behind the partials' ChainGather
  attn:
  {
    ctx: 1024
    rows: 64
    bc: 64
    w4_paired: true
    w_chunk_bytes: 65536
    w_buffers: 2
    weight_ring: { slots: 8, head: 4, batch_head: 1, queue: 12 }
    passes: 2
    stats: max
    wo_push: after_reduce
    checks: y
  }
  // the all-GEMV FFN decode block (../../../ffn/common/ffn_decode_mc): X in a_row, gate|up and down on the GEMV, 16
  // down slices of 128 a cluster, each in its own output slot, every gather behind every cluster's last down GEMV
  // (chains_after_stream), one ChainGather a cluster (a group of 16 slices)
  ffn:
  {
    blocks: 1
    dn_cols: 128
    w_chunk_bytes: 98304
    w_buffers: 2
    weight_ring: { slots: 8, head: 4, batch_head: 1, queue: 12 }
    out_slots: 16
    start_per_chip: true
    gather_relay_only: true
    chain_group: 16
    chains_after_stream: true
  }
  layer:
  {
    attn: ks
    stop: full
    // each chip's FFN weight pushes start once its attention part has ended (one L3 region for both blocks' rings)
    ffn_prefetch: after
  }
}
