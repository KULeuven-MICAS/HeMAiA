// stage0: stage 0 alone (main_bingo.py): every pass's X from the root memory chip's HBM into every chip's L3, the
// first pass's X into every cluster's L1. Model, tokens and rows are the whole block's (../full).
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 256
  rows: 128
  static_l1: true
  compact_id_maps: true
  l1_capacity: 990000
  d2d_ddr: true
}
