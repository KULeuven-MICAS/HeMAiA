// full: DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh
// 256-token prompt on 16 + 4 chiplets, the whole block (was the ladder's variant all). Two passes of 128 rows: X of a
// pass (128 x 2,048 INT8, 256 KiB) is what an L1 holds beside the weight slabs. X of both passes comes from the root
// memory chip's HBM, multicast at the start by its push engine (64 KiB tiles, a flag each); every cluster fetches the
// first pass's X in 4 row blocks and runs the first gate|up chunk one GEMM per block (x_blocks). Each weight chunk meets
// all of a pass's rows in one GEMM as it streams in; the second pass copies each chunk from the L3 ring slot it landed
// in (16 slots hold all of a cluster's chunks), so the weights stream from HBM once. Each chip's down projection is split
// by output columns between its clusters (cluster 0 takes the outputs dn_balance picks), reduced slice by slice by
// ChainGathers into the root, cluster 1's running the ring the other way (chain_alt), stored a slice late (store_lag),
// Y over the X buffers in L3 (l3_overlay). The root's clusters take fewer columns (root_light, root_cols); the last
// gate|up chunk and the first down slice run per post block (split_last, split_first_dn); INT4 in the paired layout, 64
// bytes a pass (w4_paired). ../../common/ffn_prefill_mc.py explains each parameter where it reads it; the stage apps
// beside this one take these params.
{
  stage: "full"
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 256
  rows: 128
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  x_buffers: 1
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  mapping: single_pass
  deq_per_row: true
  x_blocks: 4
  store_lag: 1
  gemm_reuse: true
  post_blocks: 4
  root_light: true
  first_blocks: 2
  split_last: true
  sym_zero: false
  dn_split: cols
  split_first_dn: true
  col_unit: 16
  dn_balance: true
  root_cols: [320, 304]
  chain_alt: true
  dn_load_early: true
  relay_on_simd: true
  first_gather_waits_copies: false
  relay_per_gather: true
  w4_paired: true
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (workloads/common/args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
}
