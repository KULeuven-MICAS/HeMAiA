// t64: Llama-3-8B's FFN (4,096 -> 14,336 -> 4,096), synthetic weights of the model's shapes in INT4, one pass of 64
// tokens on 16 + 4 chiplets with every mechanism (X multicast from the root memory chip's HBM, ChainGathers, per-edge
// synchronisation): the params of ../full at 64 tokens, its GEMMs queued and configured ahead. The FFN section's
// one-pass Llama number (it replaces the 24 Oct run, whose X sat in the root's L3).
{
  num_chiplets: 16
  num_clusters: 2
  model: llama3-8b-synthetic
  seed: 1
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 1
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  restream: true
  weight_ring:
  {
    slots: 8
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  static_l1: true
  compact_id_maps: true
  gid_lists: true
  per_chip_image: true
  desc_in_image: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  d2d_rx_yield: [255, 0]
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  split_last: true
  split_first_dn: true
  dn_load_early: true
  out_slots: 8
  start_per_chip: true
  gather_relay_only: true
  chain_group: 4
  x_early: true
  x_cast: multicast
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (mini_compiler passes/bingo_args_phases.py): the
  // root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
  // the compiler splits each GEMM, SIMD and xDMA task into configure / start / wait parts where its
  // schedule of the cores gains from it (mini_compiler passes/bingo_dfg_schedule.py)
}
