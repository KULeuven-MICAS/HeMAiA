// all_n8: the FFN strong-scaling sweep, R3, every mechanism, on 8 chips (chip_rows: the package's first rows, each with its memory
// chip). DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh 64-token
// prompt in one pass of 64 rows, X from the root memory chip's HBM; the switches of the ablation's
// R3 (../../README.md), sized for its chips: their columns and what the size forces.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  split_last: true
  split_first_dn: true
  dn_balance: true
  root_cols: [656, 656]
  chain_alt: true
  dn_load_early: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (mini_compiler passes/bingo_args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
  // the compiler splits each GEMM, SIMD and xDMA task into configure / start / wait parts where its
  // schedule of the cores gains from it (mini_compiler passes/bingo_dfg_schedule.py)
  // one ChainGather a cluster: chain_group = out_slots = every slice
  chain_group: 8
  out_slots: 8
  chip_rows: 2
}
