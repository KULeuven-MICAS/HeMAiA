// all_n8_cluster2 (all_n8_cluster after the root rings queue behind X): all_n8 (below) with the D2D yield window, every weight ring posted by its cluster's DM core
// (weight_ring.mode cluster) and X's multicast as host graph tasks (hbm_cast.mode posts), the root memory chip's
// engine queue split between them 16 + 16.
// all_n8: the FFN strong-scaling sweep, R3, every mechanism, on 8 chips (chip_rows: the package's first rows, each with its memory
// chip). DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh 64-token
// prompt in one pass of 64 rows, X from the root memory chip's HBM; the switches of the ablation's
// R3 (../../README.md), sized for its chips: their columns and what the size forces.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    mode: cluster
    queue: 16
    slots: 16
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  l3_overlay: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  split_last: true
  split_first_dn: true
  dn_balance: true
  root_cols: [656, 656]
  chain_alt: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  // one ChainGather a cluster: chain_group = out_slots = every slice
  chain_group: 8
  out_slots: 8
  chip_rows: 2
  hbm_cast:
  {
    mode: posts
    queue: 16
  }
  // the D2D links' RX yield windows, compute / memory chips: a compute chip receiving a push stream hands the
  // half-duplex link over after 255 cycles when its own writes are waiting (the layers' setting)
  d2d_rx_yield: [255, 0]
}
