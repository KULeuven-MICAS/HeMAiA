// stage45: stages 4-5 of one pass alone (main_bingo.py): the chip's A8 in L1 before the window; the down slices
// over the weight stream, the ChainGathers into the root and the stores. The mapping is the whole block's (../full)
// for one pass (tokens = rows).
{
  // every task whole (the synchronous arm beside ../stage45_async)
  async_exec: false
  num_chiplets: 16
  num_clusters: 2
  model: llama3-8b-synthetic
  tokens: 64
  rows: 64
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 8
    head: 4
    batch_head: 1
  }
  per_chip_image: true
  desc_in_image: true
  d2d_rx_yield: [255, 0]
  out_slots: 8
  gather_relay_only: true
  chain_group: 4
}
