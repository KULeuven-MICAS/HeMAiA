// bcast_reduce: R2, bcast + the in-transit reduce: ChainGathers fold the partials into the root (reduce chain); still a
// barrier after every kernel. DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's
// weights in INT4, a fresh 256-token prompt in two passes of 128 rows on 16 + 4 chiplets, X from the root memory chip's
// HBM; the mapping, chunks, slices and buffers of ../../dsv2_l0_prefill/full.
{
  stage: "full"
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 256
  rows: 128
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  x_buffers: 1
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  weight_crest: false
  bcast: bcast_l1
  reduce: chain
  sync: barrier
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  mapping: single_pass
  deq_per_row: true
  x_blocks: 4
  store_lag: 1
  gemm_reuse: true
  post_blocks: 4
  root_light: true
  first_blocks: 2
  sym_zero: false
  dn_split: cols
  col_unit: 16
  dn_balance: true
  root_cols: [320, 304]
  chain_alt: true
  relay_on_simd: true
  first_gather_waits_copies: false
  relay_per_gather: true
  w4_paired: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  barrier_at: kernel
  barrier_mode: sw
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (workloads/common/args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
}
