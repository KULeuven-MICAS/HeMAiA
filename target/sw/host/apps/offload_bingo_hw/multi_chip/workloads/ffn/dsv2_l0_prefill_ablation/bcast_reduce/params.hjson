// bcast_reduce: the paper's FFN ablation at 64 tokens on 16 chips, R2 (+ in-transit reduce): R1 (../bcast) but for reduce
// chain, with R3's (../all) one ChainGather a cluster (chain_group 8, chain_alt).
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: barrier
  l3_overlay: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  dn_balance: true
  root_cols: [320, 304]
  chain_alt: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  barrier_mode: sw
  // one ChainGather a cluster, as all
  chain_group: 8
}
