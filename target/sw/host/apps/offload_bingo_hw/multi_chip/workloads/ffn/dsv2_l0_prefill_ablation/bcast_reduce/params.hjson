// bcast_reduce: the paper's FFN ablation at 64 tokens on 16 chips, R2 (+ in-transit reduce): R1 (../bcast) but for reduce
// chain, with R3's (../all) one ChainGather a cluster (chain_group 8, chain_alt).
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: barrier
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  dn_balance: true
  root_cols: [320, 304]
  chain_alt: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  barrier_mode: sw
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (workloads/common/args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
  // GEMMs (../../common/ffn_prefill_mc.py gemm_node): gemm_start / gemm_wait pairs, the shape parameters in L1, each
  // configured ahead of its operands, a start that repeats its cluster's previous configuration writing only
  // addresses; kernel by kernel a GEMM is configured ahead only inside its kernel (no gemm_cfg_hoist)
  gemm_async: true
  gemm_shape_l1: true
  gemm_cfg_ahead: true
  // one ChainGather a cluster, as all
  chain_group: 8
}
