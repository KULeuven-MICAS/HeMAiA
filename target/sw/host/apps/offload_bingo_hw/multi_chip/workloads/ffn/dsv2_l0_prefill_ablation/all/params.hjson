// all: the paper's FFN ablation at 64 tokens on 16 chips, R3, every mechanism: X by one multicast, one ChainGather of 8
// slices a cluster, per-edge BINGO sync. DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the
// checkpoint's weights in INT4, a fresh 64-token prompt in one pass of 64 rows, X from the root memory chip's HBM. The
// same params as ../../scaling/all_n16, whose run stg_poc64_g8 is the paper's R3.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  l3_overlay: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  split_last: true
  split_first_dn: true
  dn_balance: true
  root_cols: [320, 304]
  chain_alt: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  // one ChainGather a cluster: chain_group = out_slots = every slice
  chain_group: 8
  out_slots: 8
}
