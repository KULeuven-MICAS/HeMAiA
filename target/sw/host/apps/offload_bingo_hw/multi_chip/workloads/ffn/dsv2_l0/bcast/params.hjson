// DeepSeek-V2-Lite's dense FFN (layer 0: 2048 -> 10944 -> 2048, SwiGLU) on
// hemaia_16c4m_8MBL3_2cluster, one token, INT4 weights.
// Variant bcast: x multicast by the D2D router; the chips' partials gathered by the root (iDMA pulls, SIMD adds); cross-chip dependencies replaced by the HeMAiA chip barrier (a 0xFF broadcast announce, a local poll) at every sync point.
// What each field does is in ../../common/ffn_mc.py.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 1
  wbits: 4
  w_chunk_bytes: 114688
  w_buffers: 3
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
  }
  weight_crest: false
  bcast: bcast_l1
  reduce: root
  sync: barrier
  barrier_mode: bcast
  static_l1: true
  l1_capacity: 990000
  d2d_ddr: true
}
