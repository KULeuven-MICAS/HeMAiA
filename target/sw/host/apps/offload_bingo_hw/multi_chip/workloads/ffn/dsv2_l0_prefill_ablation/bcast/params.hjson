// bcast: the paper's FFN ablation at 64 tokens on 16 chips, R1 (+ broadcast): R0 (../base) but for x_cast multicast.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: root
  sync: barrier
  l3_overlay: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  dn_balance: true
  root_cols: [320, 304]
  // the ablation's switches (../../common/ffn_prefill_mc/params.py)
  x_cast: multicast
  barrier_mode: sw
  chain_alt: false
}
