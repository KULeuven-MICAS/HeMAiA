// base_n16: the FFN strong-scaling sweep, R0, the conventional baseline, on 16 chips (chip_rows: the package's first rows, each with its memory
// chip). DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh 64-token
// prompt in one pass of 64 rows, X from the root memory chip's HBM; the switches of the ablation's
// R0 (../../README.md), sized for its chips: their columns and what the size forces.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: root
  sync: barrier
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  dn_balance: true
  root_cols: [320, 304]
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: unicast
  barrier_mode: sw
  chain_alt: false
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (workloads/common/args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
  // GEMMs (../../common/ffn_prefill_mc.py gemm_node): gemm_start / gemm_wait pairs, the shape parameters in L1, each
  // configured ahead of its operands, a start that repeats its cluster's previous configuration writing only
  // addresses; kernel by kernel a GEMM is configured ahead only inside its kernel (no gemm_cfg_hoist)
  gemm_async: true
  gemm_shape_l1: true
  gemm_cfg_ahead: true
}
