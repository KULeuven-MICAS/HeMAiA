// base_n16: the FFN strong-scaling sweep, R0, the conventional baseline, on 16 chips (chip_rows: the package's first rows, each with its memory
// chip). DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh 64-token
// prompt in one pass of 64 rows, X from the root memory chip's HBM; the switches of the ablation's
// R0 (../../README.md), sized for its chips: their columns and what the size forces.
{
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 3
  dn_cols: 128
  w_chunk_bytes: 98304
  w_buffers: 2
  weight_ring:
  {
    slots: 16
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: root
  sync: barrier
  l3_overlay: true
  deq_per_row: true
  x_blocks: 4
  post_blocks: 4
  first_blocks: 2
  dn_balance: true
  root_cols: [320, 304]
  // the ablation's switches (../../common/ffn_prefill_mc/params.py)
  x_cast: unicast
  barrier_mode: sw
  chain_alt: false
}
