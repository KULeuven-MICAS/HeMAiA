// all_n4: the FFN strong-scaling sweep, R3, every mechanism, on 4 chips (chip_rows: the package's first rows, each with its memory
// chip). DeepSeek-V2-Lite's dense FFN (layer 0: 2,048 -> 10,944 -> 2,048), the checkpoint's weights in INT4, a fresh 64-token
// prompt in one pass of 64 rows, X from the root memory chip's HBM; the switches of the ablation's
// R3 (../../README.md), sized for its chips: their columns and what the size forces.
{
  stage: "full"
  num_chiplets: 16
  num_clusters: 2
  model: dsv2-lite-l0
  seed: 1
  tokens: 64
  rows: 64
  wbits: 4
  blocks: 2
  dn_cols: 64
  w_chunk_bytes: 90112
  w_buffers: 2
  x_buffers: 1
  weight_ring:
  {
    slots: 16
    batch: 4
    policy: 1
    head: 4
    batch_head: 1
  }
  bcast: bcast_l1
  reduce: chain
  sync: edge
  static_l1: true
  compact_id_maps: true
  l3_overlay: true
  l1_capacity: 990000
  d2d_ddr: true
  mapping: single_pass
  deq_per_row: true
  x_blocks: 4
  store_lag: 1
  gemm_reuse: true
  post_blocks: 4
  root_light: true
  first_blocks: 2
  split_last: true
  sym_zero: false
  dn_split: cols
  split_first_dn: true
  col_unit: 16
  dn_balance: true
  root_cols: [1344, 1328]
  chain_alt: true
  dn_load_early: true
  relay_on_simd: true
  first_gather_waits_copies: false
  relay_per_gather: true
  w4_paired: true
  // the ablation's switches (../../common/ffn_prefill_mc.py, THE ABLATION)
  x_cast: multicast
  // every cluster's args in phases of 10,000 B, two alternating L1 regions (workloads/common/args_phases.py): at
  // T = 256 the root's args, beside its static buffers, leave no room for the SIMD kernels' scratch pools
  args_phase_bytes: 10000
  // GEMMs (../../common/ffn_prefill_mc.py gemm_node): gemm_start / gemm_wait pairs, the shape parameters in L1, each
  // configured ahead of its operands, a start that repeats its cluster's previous configuration writing only
  // addresses (gemm_reuse), the configure ahead of the waits before its start (gemm_cfg_hoist)
  gemm_async: true
  gemm_shape_l1: true
  gemm_cfg_ahead: true
  gemm_cfg_hoist: true
  // the output does not fit L1 whole at 4 chips: 2 slices a ChainGather through 4 output slots, one group writing while
  // the other reduces
  chain_group: 2
  out_slots: 4
  chip_rows: 1
}
