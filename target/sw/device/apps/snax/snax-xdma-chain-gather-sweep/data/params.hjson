{
  // Cross-die ChainGather scaling sweep on the 16-chiplet platform (hemaia_16chiplet:
  // a 4x4 compute grid, 1 cluster per chiplet, memory chiplet at [4,0]).
  //
  // num_chiplets  the full grid; chiplet at snake index i owns partial i. MUST match the
  //               RTL cfg's compute-chiplet count (there is a _Static_assert).
  // sweep_p       the chain widths to measure, in order. Repeating a width runs it again:
  //               the second defect fixed on 2026-09-06 needs THREE rounds to surface at
  //               P=2 and only TWO once the chain has a middle hop, so a width run once
  //               proves nothing. Every entry must be <= num_chiplets and every prefix of
  //               the snake is itself a valid all-adjacent chain, so any width works.
  // partial_elems 16 fp32 = one 64 B beat = the xDMA data width.
  //
  // Full scaling sweep, two rounds of each width. P=2 already has three clean rounds from
  // the 2x2 bring-up, and a width with a middle hop surfaces the defect on the second.
  num_chiplets: 16
  partial_elems: 16
  sweep_p: [2, 2, 4, 4, 8, 8, 16, 16]
}
