{
  // In-fabric reduction sweep: CHAIN vs TREE, both junctions, per width.
  //
  // num_chiplets  the full grid; chiplet at snake index i owns partial i. MUST match the
  //               RTL cfg's compute-chiplet count (there is a _Static_assert).
  // num_chiplets_x the grid's width (chiplets per row). The softmax-statistics golden of a
  //               tree round folds in the tree's own order, so the datagen needs the grid.
  //               MUST match the RTL cfg's N_CHIPLETS_X (there is a _Static_assert).
  // sweep_p       the widths to measure, in order. A repeated width runs again -- worth
  //               doing, since every ChainGather defect found so far surfaced only on a
  //               SECOND round through the same shape, and the tree adds two pieces of
  //               per-round state (the row slots and the s2done config-plane handshake)
  //               that a single round would not exercise.
  // partial_elems 16 fp32 = one 64 B beat = the xDMA data width. The linear partial only;
  //               a softmax-statistics partial is always one 128 B group.
  //
  // Full 4x4 sweep. The tree needs >= 2 FULL rows, so on a 4-wide grid it is n/a at P=2 and
  // P=4 and measured at P=8 (2 rows) and P=16 (4 rows). P=16 is the one that matters: its
  // stage-2 chain has middle hops, so (0,1) and (0,2) are stage-1 collectors and then
  // stage-2 middle hops -- a role change a flat chain never performs.
  num_chiplets: 16
  num_chiplets_x: 4
  partial_elems: 16
  sweep_p: [2, 4, 8, 8, 16, 16]
}
