{
  // Tile counts, per FPGA. Actual local matrix dimensions are
  // (M * meshRow) x (K * tileSize) times (K * tileSize) x (N * meshCol).
  // The complete GEMM has twice as many rows; both FPGAs use the same B.
  M: 2,
  K: 2,
  N: 2,
  // Shape 2 is bank-aligned on both split and tapeout VersaCore clusters.
  array_shape: 2,
}
