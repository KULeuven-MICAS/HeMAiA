// The collective apps (snax-coll-*): one data set for all five primitives.
//   nbytes         each chip's contribution, FP16 (broadcast: the root's buffer)
//   num_chiplets   the compute chips on the snake; must match the platform
//   P              participant counts, a prefix of the snake each
//   repeats        timed repeats per (implementation, P)
//   empty_repeats  empty points per P (GO -> READY round trip, subtracted)
//   chain_chunks   chunks the software chain reduce pipelines its 128 KiB in
//   impls          optional: only these implementations, e.g. ["a2a", "ring", "rd"] (to
//                  complete a run that stopped; with P [16] and repeats 1). Without it every
//                  implementation runs except d2dn, which deadlocks the D2D from P = 4
//   ring           optional: the ring arms' cycle, "short" (default: at P = 16 single hops
//                  and two memory-column crossings) or "snake" (the snake, closed by one step)
{
  nbytes: 131072
  num_chiplets: 16
  P: [2, 4, 8, 16]
  repeats: 2
  empty_repeats: 2
  chain_chunks: 4
  seed: 1
}
